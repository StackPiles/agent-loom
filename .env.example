# Local installation: copy to .env only when changing these defaults.
# Model endpoint, model ID, and model API key are configured in the browser.
LOOM_HOST=127.0.0.1
LOOM_PORT=3210
LOOM_DATA_DIR=.loom

# Required by compose.yaml and when binding the app beyond loopback.
# Generate a token with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Paste the generated value after the equals sign and use it to unlock the UI.
# This is the app access token; it is separate from your model provider API key.
LOOM_API_TOKEN=

# Optional unattended initial setup. These values seed a NEW database only.
# After first launch, change model settings in the browser.
# LOOM_MODEL_BASE_URL=http://127.0.0.1:1234/v1
# LOOM_MODEL_ID=your-server-model-id
# LOOM_MODEL_API_KEY=

# Optional: disable opening OS folder dialogs from the local UI.
# LOOM_NATIVE_PICKER=0
